# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to version control.

# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------
# One of: openai, anthropic, azure_openai, ollama (local)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=

# ---------------------------------------------------------------------------
# Speech-to-Text provider
# ---------------------------------------------------------------------------
# One of: whisper_local, openai_whisper_api, azure
STT_PROVIDER=whisper_local
STT_API_KEY=

# ---------------------------------------------------------------------------
# Text-to-Speech provider
# ---------------------------------------------------------------------------
# One of: pyttsx3 (offline), edge_tts, azure, openai
TTS_PROVIDER=pyttsx3
TTS_API_KEY=

# ---------------------------------------------------------------------------
# Wake word
# ---------------------------------------------------------------------------
WAKE_WORD="Hey Jarvis"
# Porcupine access key, only required if WAKE_WORD_ENGINE=porcupine
PORCUPINE_ACCESS_KEY=

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
DATA_DIR=./data
CONFIG_FILE=./config/config.yaml

# Require explicit confirmation for HIGH/CRITICAL permission tools (recommended: true)
REQUIRE_CONFIRMATION=true
