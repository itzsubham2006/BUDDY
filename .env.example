# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to version control.

# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------
# Options:
#   - local (or offline): 100% offline, zero API keys required. Basic computer-control
#                         commands (open apps, volume, time, system info, web search) work directly.
#   - openrouter: Uses OpenRouter API (https://openrouter.ai). Model e.g. nvidia/nemotron-3.5-lightning
#   - openai: Uses OpenAI API (or compatible). Model e.g. gpt-4o-mini
#   - anthropic: Uses Anthropic API. Model e.g. claude-sonnet-4-6
LLM_PROVIDER=local
LLM_MODEL=offline
# Optional for local mode; required for openrouter, openai, or anthropic
LLM_API_KEY=

# ---------------------------------------------------------------------------
# Speech-to-Text provider
# ---------------------------------------------------------------------------
# One of: whisper_local, openai_whisper_api, azure
STT_PROVIDER=whisper_local
STT_API_KEY=

# ---------------------------------------------------------------------------
# Text-to-Speech provider
# ---------------------------------------------------------------------------
# One of: pyttsx3 (offline), edge_tts, azure, openai
TTS_PROVIDER=pyttsx3
TTS_API_KEY=

# ---------------------------------------------------------------------------
# Wake word
# ---------------------------------------------------------------------------
WAKE_WORD="Hi Buddy"
# Porcupine access key, only required if WAKE_WORD_ENGINE=porcupine
PORCUPINE_ACCESS_KEY=

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
AGENT_NAME=Buddy
LOG_LEVEL=INFO
DATA_DIR=./data
CONFIG_FILE=./config/config.yaml

# Require explicit confirmation for HIGH/CRITICAL permission tools (recommended: true)
REQUIRE_CONFIRMATION=true
